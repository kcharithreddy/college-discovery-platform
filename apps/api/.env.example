# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/college_discovery?schema=public"

# Secret used to sign login tokens. Required in production — use a long random string.
JWT_SECRET="change-this-secret"

PORT=4000

# Frontend origin(s) allowed by CORS. Separate multiple origins with commas.
CLIENT_URL=http://localhost:3000

# OAuth client ID from Google Cloud Console (optional — Google sign-in is disabled without it).
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web.
GOOGLE_CLIENT_ID=

# When true, mobile OTP is always 123456 and is returned in the API response (no SMS is sent).
# Defaults to true outside production and false in production.
# DEMO_OTP=true
